# Every environment variable your app needs, with harmless placeholder values.
# Copy to .env for local use. Real values go into your hosting provider's settings, never into git.
# In a codespace, put the secret ones in the repository's Codespaces secrets instead of a file.
PORT=3000
DATABASE_URL=postgres://user:password@host/dbname
SESSION_SECRET=change-me
PUBLIC_BASE_URL=http://localhost:3000

# Sign in with Google. Create an OAuth client at console.cloud.google.com and leave it in
# "Testing" mode with yourself as a test user: that is free and needs no app verification.
# Add every address you will sign in from as an authorized redirect URI, including your
# codespace's forwarded URL and your Render URL. Google requires https off localhost.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The model feature. A free key comes from aistudio.google.com; any provider is fine,
# and so is a model that runs locally, as long as the app still works without it.
GEMINI_API_KEY=
MODEL_NAME=gemini-2.5-flash

# A session token your MCP server signs in with. It grants exactly what that user may do,
# and nothing more, because the tools go through the same services as the HTTP API.
MCP_TOKEN=
